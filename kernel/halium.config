CONFIG_SYSVIPC=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_MODULE_FORCE_LOAD=y
# CONFIG_STATIC_USERMODEHELPER is not set
# these want the openssl headers for scripts/extract-cert, absent on the build host
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_SYSTEM_DATA_VERIFICATION is not set
# CONFIG_FS_VERITY_BUILTIN_SIGNATURES is not set
# required by systemd: automounting of its internal mount points
CONFIG_AUTOFS4_FS=y
# the cgroup controllers systemd and the Halium config checker ask for
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PERF=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_NET_CLS_CGROUP=y
# the Mali GPU DVFS driver hangs the boot at 2.1 s - off until understood
# CONFIG_MTK_GPU_COMMON_DVFS_SUPPORT is not set
# CONFIG_MTK_GPU_SWPM_SUPPORT is not set

# Bluetooth: without rfkill there is no /dev/rfkill and bluebinder restarts
# forever ("Failed to open /dev/rfkill 2").
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y

# The Bluetooth stack itself is disabled wholesale in the Xiaomi tree.
# bluebinder works through the virtual HCI (/dev/vhci) provided by
# CONFIG_BT_HCIVHCI, which in turn pulls in CONFIG_BT. Without this the service
# restarts endlessly: "Failed to open /dev/vhci device".
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIVHCI=y

# AppArmor is what Ubuntu Touch's app confinement rests on. Without it media-hub
# gets a meaningless profile name on the first request from an app ("Invalid
# profile name kernel") and dies with SIGSEGV, so the player plays nothing.
#
# On 4.14 only one major security module can be active at a time, so turning
# AppArmor on makes it the major module and leaves SELinux compiled but
# inactive.
#DISABLED# CONFIG_SECURITY_APPARMOR=y
#DISABLED# CONFIG_SECURITY_APPARMOR_HASH=y
#DISABLED# CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
#DISABLED# CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
#DISABLED# CONFIG_DEFAULT_SECURITY_APPARMOR=y
#DISABLED# # CONFIG_DEFAULT_SECURITY_SELINUX is not set
#DISABLED# CONFIG_DEFAULT_SECURITY="apparmor"

# WARNING: the AppArmor block above is disabled on purpose. It was tested and it
# does NOT work: on 4.14 only one major security module is active at a time, and
# enabling AppArmor disables SELinux, without which graphics fall apart -
# lightdm restarts about six times in half a minute and the screen flickers.
# The media-hub problem is solved a different way instead; see
# docs/fix-media-hub.md.

# VPN: awg-quick installs an anti-spoofing rule via iptables -m addrtype.
# Without this option iptables-restore aborts wholesale ("Couldn't load match
# addrtype") and the tunnel never comes up. Needed for both IPv4 and IPv6.
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# debugfs, for /sys/kernel/debug/binder/transactions: without it you cannot see
# which binder transaction is stuck and who is waiting for whom, which is
# exactly how the video recording hang presents (the app sits in
# binder_ioctl_write_read while the Codec2 service is idle).
# CONFIG_STACKTRACE and CONFIG_DEBUG_KERNEL are already on in this tree.
CONFIG_DEBUG_FS=y
