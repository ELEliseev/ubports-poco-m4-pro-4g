 		return -EACCES;
+	}
 
 	/* Control clients must be explicitly allowed */
 	if (unlikely(!(flags & DRM_CONTROL_ALLOW) &&
@@ -846,8 +863,13 @@ long drm_ioctl(struct file *filp,
 
 	if (kdata != stack_kdata)
