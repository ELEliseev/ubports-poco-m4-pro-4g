@@ -177,8 +178,40 @@ int drm_setmaster_ioctl(struct drm_device *dev, void *data,
 		goto out_unlock;
 
 	if (dev->master) {
-		ret = -EINVAL;
-		goto out_unlock;
+		/*
+		 * The MediaTek vendor hwcomposer opens /dev/dri/card0 twice:
+		 * first the PQ subsystem, then the display code proper, which
+		 * is the one that asks to be master. The first opener becomes
+		 * master implicitly (drm_master_open), so the second one hits
+		 * -EINVAL forever and spins on retrying. On stock Android the
+		 * order is reversed and the problem never shows.
+		 *
+		 * Within a single process there is nobody to share the display
+		 * with, so hand the master over: the old handle stops being the
+		 * current master (drm_is_current_master compares against
+		 * dev->master) and the caller picks it up the normal way below.
+		 */
+		if (dev->master->owner_tgid != task_tgid_nr(current)) {
+			/*
+			 * A different process. This happens when the vendor
+			 * composer@2.1 service starts after the Ubuntu Touch
+			 * compositor: by then the compositor owns the display.
+			 * Refusing here deadlocks the system - the service
+			 * never registers IComposerExt, and the compositor
+			 * waits for that service over HIDL forever, because the
+			 * vendor hwcomposer is loaded straight into it.
+			 *
+			 * So answer with success without transferring
+			 * ownership: the real master stays with the
+			 * compositor, and the service gets as far as
+			 * registering. The right to actually modeset for these
+			 * nominal masters is granted separately, in
+			 * drm_ioctl(). On a phone with one compositor there is
+			 * nobody else to share the display with.
+			 */
+			goto out_unlock;
+		}
+		drm_master_put(&dev->master);
 	}
 
 	if (!file_priv->master) {
@@ -193,6 +226,9 @@ int drm_setmaster_ioctl(struct drm_device *dev, void *data,
 
 	ret = drm_set_master(dev, file_priv, false);
 out_unlock:
+	pr_info_ratelimited("drm: SET_MASTER from %s[%d] -> %d (owner %d)\n",
+			    current->comm, task_tgid_nr(current), ret,
+			    dev->master ? dev->master->owner_tgid : -1);
 	mutex_unlock(&dev->master_mutex);
 	return ret;
 }
@@ -288,6 +324,25 @@ void drm_master_release(struct drm_file *file_priv)
  * Most of the modern IOCTL which require DRM_MASTER are for kernel modesetting
  * - the current master is assumed to own the non-shareable display hardware.
  */
+/**
+ * drm_same_process_as_master - is the display owned by this same process
+ * @fpriv: a client of the primary node
+ *
+ * The MediaTek vendor stack opens /dev/dri/card0 several times from one
+ * process, and only the first handle becomes the real master. The other handles
+ * of that same process may drive the display: there is no contention. Returns
+ * false for other processes - otherwise the vendor composer@2.1 service starts
+ * programming the panel in parallel with the compositor and the device hangs.
+ */
+bool drm_same_process_as_master(struct drm_file *fpriv)
+{
+	struct drm_device *dev = fpriv->minor->dev;
+
+	return fpriv->master && dev->master &&
+	       dev->master->owner_tgid == task_tgid_nr(current);
+}
+EXPORT_SYMBOL(drm_same_process_as_master);
+
 bool drm_is_current_master(struct drm_file *fpriv)
 {
 	return fpriv->is_master && fpriv->master == fpriv->minor->dev->master;
