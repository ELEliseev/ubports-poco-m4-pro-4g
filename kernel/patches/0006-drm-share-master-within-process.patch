diff --git a/drivers/gpu/drm/mediatek/mtk_drm_drv.c b/drivers/gpu/drm/mediatek/mtk_drm_drv.c
index 8b7c6c736..a6812bf17 100644
--- a/drivers/gpu/drm/mediatek/mtk_drm_drv.c
+++ b/drivers/gpu/drm/mediatek/mtk_drm_drv.c
@@ -2654,7 +2654,34 @@ int mtk_drm_get_master_info_ioctl(struct drm_device *dev,
 {
 	int *ret = (int *)data;
 
-	*ret = drm_is_current_master(file_priv);
+	/*
+	 * The vendor hwcomposer spins on this query and does nothing until it
+	 * hears "yes" ([DRMDEV] failed to get drm master, retry: N).
+	 *
+	 * On Ubuntu Touch that same hwcomposer is loaded straight into the
+	 * lomiri-system-compositor process, and the real master there is not its
+	 * handle: somebody else opened the display first (the PQ subsystem
+	 * inside the same process, or the vendor composer@2.1 service). So treat
+	 * the second handle as a master too - but only when the real owner of
+	 * the display is the same process. Saying "yes" to everyone is not an
+	 * option: the vendor composer@2.1 service in the Android container then
+	 * starts programming the panel at the same time as the compositor, and
+	 * the device hangs solid before the boot finishes (tested).
+	 */
+	/*
+	 * Answer "yes" to everyone. The real owner of the display remains
+	 * whoever opened the node first (in our layout, the composer@2.1 service
+	 * from the Android container): the right to program the panel is checked
+	 * separately in drm_ioctl(), and there the concession only applies within
+	 * the owning process. So two parties never touch the panel at once -
+	 * which is exactly what hung the device when the concession was global.
+	 *
+	 * Without this answer the copy of hwcomposer loaded inside
+	 * lomiri-system-compositor polls forever (hundreds of thousands of calls
+	 * a second), holding its main thread, and lightdm restarts the
+	 * compositor on a timeout once a minute.
+	 */
+	*ret = 1;
 
 	return 0;
 }
diff --git a/include/drm/drm_auth.h b/include/drm/drm_auth.h
