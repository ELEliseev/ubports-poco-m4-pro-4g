diff -urN a/drivers/gpu/arm/midgard/mtk_kernel414_compat.h b/drivers/gpu/arm/midgard/mtk_kernel414_compat.h
--- a/drivers/gpu/arm/midgard/mtk_kernel414_compat.h
+++ b/drivers/gpu/arm/midgard/mtk_kernel414_compat.h
@@ -0,0 +1,42 @@
+/*
+ * Mali r32p1 compatibility with kernel 4.14.
+ *
+ * The driver comes from a 4.19+ tree and in places uses the mmap_sem wrappers
+ * that only arrived in 5.8 (commit d8ed45c5dcd4 "mmap locking API"). On 4.14
+ * the same operations are done directly on mm->mmap_sem.
+ *
+ * Pulled in with -include from Kbuild-mtk-custom-env, so no heavy headers here:
+ * the macros expand at the point of use, where the declarations they need are
+ * already in scope.
+ */
+#ifndef MTK_KERNEL414_COMPAT_H
+#define MTK_KERNEL414_COMPAT_H
+
+#include <linux/version.h>
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 8, 0)
+
+#define mmap_assert_locked(mm)	lockdep_assert_held(&(mm)->mmap_sem)
+#define mmap_read_lock(mm)	down_read(&(mm)->mmap_sem)
+#define mmap_read_unlock(mm)	up_read(&(mm)->mmap_sem)
+#define mmap_read_trylock(mm)	down_read_trylock(&(mm)->mmap_sem)
+#define mmap_write_lock(mm)	down_write(&(mm)->mmap_sem)
+#define mmap_write_unlock(mm)	up_write(&(mm)->mmap_sem)
+#define mmap_write_downgrade(mm) downgrade_write(&(mm)->mmap_sem)
+
+#endif /* < 5.8.0 */
+
+/* sysfs_emit arrived in 5.10 (commit 2efc459d06f1). Before that one used
+ * scnprintf; a sysfs attribute buffer is exactly one page, so the limit is the
+ * same.
+ */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0)
+
+#define sysfs_emit(buf, fmt, ...) \
+	scnprintf((buf), PAGE_SIZE, fmt, ##__VA_ARGS__)
+#define sysfs_emit_at(buf, at, fmt, ...) \
+	scnprintf((buf) + (at), PAGE_SIZE - (at), fmt, ##__VA_ARGS__)
+
+#endif /* < 5.10.0 */
+
+#endif /* MTK_KERNEL414_COMPAT_H */
