#!/usr/bin/env python3
"""Convert an AmneziaVPN configuration into something awg-quick understands.

Accepts:
  * a vpn://... link   - what the AmneziaVPN app shares;
  * a file containing such a link;
  * a ready .conf (WireGuard/AmneziaWG), which is simply copied.

Writes the result to /etc/amnezia/amneziawg/NAME.conf.

    awg-import vpn://AAAA...        # the name comes from the configuration
    awg-import myvpn.conf office    # or give the tunnel a name
"""
import base64
import json
import os
import re
import sys
import zlib

CONF_DIR = "/etc/amnezia/amneziawg"

# AmneziaWG obfuscation fields, in the order Amnezia's documentation uses.
AWG_KEYS = ["Jc", "Jmin", "Jmax", "S1", "S2", "H1", "H2", "H3", "H4"]


def fail(msg):
    print("error: " + msg, file=sys.stderr)
    sys.exit(1)


def decode_vpn_link(link):
    """vpn://... -> the parsed configuration JSON."""
    payload = link.strip()[len("vpn://"):]
    payload = payload.replace("-", "+").replace("_", "/")
    payload += "=" * (-len(payload) % 4)
    try:
        raw = base64.b64decode(payload)
    except Exception as e:
        fail("link does not decode as base64: %s" % e)

    # Qt's qCompress: a 4-byte length, then a zlib stream.
    for data in (raw[4:], raw):
        for wbits in (15, -15, 47):
            try:
                text = zlib.decompress(data, wbits)
                return json.loads(text)
            except Exception:
                continue
    # Sometimes it is not compressed at all.
    try:
        return json.loads(raw)
    except Exception:
        fail("could not decompress the link; it may be a different format version")


def find_wg_config(obj):
    """Find the awg/wireguard block inside the configuration."""
    found = []

    def walk(node):
        if isinstance(node, dict):
            for key, value in node.items():
                if key in ("awg", "wireguard") and isinstance(value, dict):
                    found.append(value)
                walk(value)
        elif isinstance(node, list):
            for item in node:
                walk(item)

    walk(obj)
    return found[0] if found else None



def substitute(conf, *sources):
    """Amnezia ships a template with placeholders like $PRIMARY_DNS; fill them in.

    When there is no value, drop the whole line: awg-quick hands DNS to
    resolvectl verbatim, and a literal "$PRIMARY_DNS" breaks bringing the
    tunnel up.
    """
    def find(*names):
        for n in names:
            for src in sources:
                if isinstance(src, dict) and src.get(n):
                    return str(src[n])
        return None

    repl = {
        "$PRIMARY_DNS": find("dns1", "primary_dns"),
        "$SECONDARY_DNS": find("dns2", "secondary_dns"),
    }
    for key, value in repl.items():
        if value:
            conf = conf.replace(key, value)

    # anything left unsubstituted goes away together with its line
    lines = [ln for ln in conf.split("\n") if "$" not in ln]

    # awg rejects empty-valued lines (I2=, I3= and friends in AmneziaWG 2.0):
    # "Line unrecognized: `I2='" and parsing stops there.
    kept = []
    for ln in lines:
        t = ln.strip()
        if t and not t.startswith(("[", "#")) and "=" in t:
            if not t.split("=", 1)[1].strip(" ,"):
                continue
        kept.append(ln)
    return "\n".join(kept)


def build_conf(block, root=None):
    """Build the .conf text from a configuration block."""
    root = root or {}
    # Often a ready-made config sits as a string in last_config.
    inner = block.get("last_config")
    if isinstance(inner, str):
        try:
            inner = json.loads(inner)
        except Exception:
            if "[Interface]" in inner:
                return substitute(inner, block, root)
            inner = None
    if isinstance(inner, dict):
        if isinstance(inner.get("config"), str) and "[Interface]" in inner["config"]:
            return substitute(inner["config"], block, root)
        block = {**block, **inner}

    def get(*names):
        for n in names:
            for src in (block, inner or {}):
                if isinstance(src, dict) and src.get(n) not in (None, ""):
                    return str(src[n])
        return None

    priv = get("client_priv_key", "PrivateKey", "privateKey")
    addr = get("client_ip", "Address", "address")
    pub = get("server_pub_key", "PublicKey", "publicKey")
    psk = get("psk_key", "PresharedKey")
    host = get("hostName", "Endpoint", "host")
    port = get("port", "Port")
    dns1 = get("dns1", "DNS")
    dns2 = get("dns2")
    allowed = get("allowed_ips", "AllowedIPs") or "0.0.0.0/0, ::/0"

    if not (priv and pub and host):
        fail("the link has no keys or server address; export the configuration "
             "as an AmneziaWG .conf file and pass that instead")

    if addr and "/" not in addr:
        addr += "/32"
    if port and ":" not in host:
        host = "%s:%s" % (host, port)

    lines = ["[Interface]", "PrivateKey = " + priv]
    if addr:
        lines.append("Address = " + addr)
    dns = ", ".join(d for d in (dns1, dns2) if d)
    if dns:
        lines.append("DNS = " + dns)
    for k in AWG_KEYS:
        v = get(k, k.lower())
        if v:
            lines.append("%s = %s" % (k, v))
    lines += ["", "[Peer]", "PublicKey = " + pub]
    if psk:
        lines.append("PresharedKey = " + psk)
    lines += ["AllowedIPs = " + allowed, "Endpoint = " + host,
              "PersistentKeepalive = 25", ""]
    return "\n".join(lines)


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    source = sys.argv[1]
    name = sys.argv[2] if len(sys.argv) > 2 else None

    if source in ("-", "/dev/stdin"):
        body = sys.stdin.read()
    elif os.path.exists(source) and not os.path.isdir(source):
        body = open(source, encoding="utf-8", errors="replace").read()
    else:
        body = source

    link = None
    match = re.search(r"vpn://\S+", body)
    if match:
        link = match.group(0)

    if link:
        data = decode_vpn_link(link)
        conf = build_conf(find_wg_config(data) or {}, data)
    elif "[Interface]" in body:
        conf = body
    else:
        fail("this is neither a vpn:// link nor a .conf file")

    if not name:
        name = "amnezia"
    name = re.sub(r"[^A-Za-z0-9_=+.-]", "_", name)[:15]

    if os.geteuid() != 0:
        fail("run this under sudo")

    os.makedirs(CONF_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(CONF_DIR, name + ".conf")
    with open(path, "w", encoding="utf-8") as f:
        f.write(conf)
    os.chmod(path, 0o600)

    print("configuration saved: %s" % path)
    print()
    print("bring up:          sudo awg-quick up %s" % name)
    print("bring down:        sudo awg-quick down %s" % name)
    print("status:            sudo awg show")
    print("enable at boot:    sudo systemctl enable awg-quick@%s" % name)


if __name__ == "__main__":
    main()
